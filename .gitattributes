# Normalise line endings in the repository
* text=auto

# Binaries
*.jar binary
*.png binary
*.ogg binary
*.zip binary

# Keep the Gradle wrapper usable on every platform
gradlew text eol=lf
gradlew.bat text eol=crlf

# Sources and configs as LF
*.java text eol=lf
*.gradle text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.properties text eol=lf
